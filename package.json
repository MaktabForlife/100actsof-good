{
  "name": "100actsof-good",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/env.mjs node_modules/vinext/dist/cli.js dev --hostname 127.0.0.1 --port 5174",
    "build": "node --import ./scripts/env.mjs node_modules/vinext/dist/cli.js build",
    "preview": "node --import ./scripts/env.mjs node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --import ./scripts/env.mjs node_modules/wrangler/bin/wrangler.js d1 migrations apply DB --local --config wrangler.jsonc",
    "build:preview": "node scripts/preview.mjs build",
    "deploy:preview": "node scripts/preview.mjs deploy",
    "deploy": "node scripts/preview.mjs all",
    "cf:types": "node --import ./scripts/env.mjs node_modules/wrangler/bin/wrangler.js types --include-runtime=false"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
